{
	"name": "lenqo",
	"version": "0.1.2",
	"description": "Local-first visual review for Playwright captures and live previews.",
	"repository": { "type": "git", "url": "git+https://github.com/wadakatu/lenqo.git" },
	"homepage": "https://github.com/wadakatu/lenqo#readme",
	"bugs": { "url": "https://github.com/wadakatu/lenqo/issues" },
	"keywords": [
		"playwright",
		"visual-review",
		"design-review",
		"screenshots"
	],
	"type": "module",
	"bin": {
		"lenqo": "bin/lenqo.mjs"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.mjs"
		},
		"./playwright": {
			"types": "./src/playwright.d.ts",
			"import": "./src/playwright.mjs"
		}
	},
	"files": [
		"assets",
		"bin",
		"src",
		"docs",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"check": "node --check src/cli.mjs && node --check src/onboarding.mjs && node --check src/index.mjs && node --check src/playwright.mjs && node --check bin/lenqo.mjs",
		"test:install": "node tests/install-smoke.mjs",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "node --test tests/*.test.mjs",
		"test:prepare": "node tests/prepare.mjs",
		"test:e2e": "npm run test:prepare && playwright test",
		"prepack": "npm run check && npm run test:unit"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.50.0"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1"
	},
	"license": "MIT"
}
